<%- include("../partials/header", { pageTitle: "Új sütemény hozzáadása" }) %>

					<section>
						<header class="main">
							<h1>Új sütemény hozzáadása</h1>
							<p>Töltse ki az alábbi adatokat új sütemény rögzítéséhez a <code>sutik</code> kollekcióba.</p>
						</header>

						<div class="row">
							<div class="col-6 col-12-small">
								<form method="post" action="/crud/insert" novalidate>
									<div class="row gtr-uniform">
										<div class="col-12">
											<label for="nev">Sütemény neve *</label>
											<input type="text" name="nev" id="nev" value="<%= formData.nev || '' %>" placeholder="pl. Eszterházy torta" />
											<% if (errors.nev) { %>
												<span class="field-error"><%= errors.nev.message %></span>
											<% } %>
										</div>
										<div class="col-12">
											<label for="tipus">Típus *</label>
											<input type="text" name="tipus" id="tipus" list="tipus-lista" value="<%= formData.tipus || '' %>" placeholder="pl. torta, krémes, pite, vegyes..." />
											<datalist id="tipus-lista">
												<% tipusok.forEach(t => { %>
													<option value="<%= t %>"></option>
												<% }) %>
											</datalist>
											<% if (errors.tipus) { %>
												<span class="field-error"><%= errors.tipus.message %></span>
											<% } %>
										</div>
										<div class="col-12">
											<input type="checkbox" id="dijazott" name="dijazott" value="1" <%= formData.dijazott ? "checked" : "" %> />
											<label for="dijazott">Díjazott a Magyarország Tortája versenyen</label>
										</div>
										<div class="col-12">
											<ul class="actions">
												<li><button type="submit" class="button primary">Mentés</button></li>
												<li><a href="/crud" class="button">Vissza a listához</a></li>
											</ul>
										</div>
									</div>
								</form>
							</div>
						</div>
					</section>

<%- include("../partials/footer") %>

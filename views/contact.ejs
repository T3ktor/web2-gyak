<%- include("partials/header", { pageTitle: "Kapcsolat" }) %>

					<section>
						<header class="main">
							<h1>Kapcsolat</h1>
							<p>Küldjön üzenetet cukrászdánk tulajdonosának! Az űrlap szerver oldali Mongoose validációval működik, és az elküldött üzenetek az adatbázisba kerülnek.</p>
						</header>

						<div class="row gtr-200">
							<div class="col-7 col-12-medium">
								<h3>Üzenetküldő űrlap</h3>
								<form method="post" action="/kapcsolat" novalidate>
									<div class="row gtr-uniform">
										<div class="col-6 col-12-xsmall">
											<label for="nev">Név *</label>
											<input type="text" name="nev" id="nev" value="<%= formData.nev || '' %>" placeholder="Teljes név (min. 3 karakter)" />
											<% if (errors.nev) { %>
												<span class="field-error"><%= errors.nev.message %></span>
											<% } %>
										</div>
										<div class="col-6 col-12-xsmall">
											<label for="email">E-mail cím *</label>
											<input type="email" name="email" id="email" value="<%= formData.email || '' %>" placeholder="pelda@domain.hu" />
											<% if (errors.email) { %>
												<span class="field-error"><%= errors.email.message %></span>
											<% } %>
										</div>
										<div class="col-12">
											<label for="targy">Tárgy *</label>
											<input type="text" name="targy" id="targy" value="<%= formData.targy || '' %>" placeholder="Üzenet tárgya (min. 3 karakter)" />
											<% if (errors.targy) { %>
												<span class="field-error"><%= errors.targy.message %></span>
											<% } %>
										</div>
										<div class="col-12">
											<label for="uzenet">Üzenet szövege *</label>
											<textarea name="uzenet" id="uzenet" rows="5" placeholder="Írja meg üzenetét (legalább 10 karakter)..."><%= formData.uzenet || '' %></textarea>
											<% if (errors.uzenet) { %>
												<span class="field-error"><%= errors.uzenet.message %></span>
											<% } %>
										</div>
										<div class="col-12">
											<ul class="actions">
												<li><button type="submit" class="button primary">Üzenet elküldése</button></li>
												<li><a href="/kapcsolat" class="button">Mezők törlése</a></li>
											</ul>
										</div>
									</div>
								</form>
							</div>

							<div class="col-5 col-12-medium">
								<div class="box">
									<h3>Elérhetőségeink</h3>
									<p>Szívesen válaszolunk egyedi tortarendeléssel, esküvői desszertasztallal vagy allergén-információkkal kapcsolatos kérdéseire.</p>
									<ul class="contact">
										<li class="icon solid fa-envelope">info@edesharmonia.hu</li>
										<li class="icon solid fa-phone">+36 76 555-1234</li>
										<li class="icon solid fa-home">6000 Kecskemét, Izsáki út 10.</li>
									</ul>
									<hr />
									<% if (user) { %>
										<p>Bejelentkezett felhasználóként megtekintheti az összes beküldött üzenetet:</p>
										<a href="/uzenetek" class="button small">Üzenetek megtekintése</a>
									<% } else { %>
										<p>Az elküldött üzenetek listáját csak <a href="/login">bejelentkezett felhasználók</a> tekinthetik meg.</p>
									<% } %>
								</div>
							</div>
						</div>
					</section>

<%- include("partials/footer") %>
